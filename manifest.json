{
  "manifest_version": 3,
  "name": "Daily Work Tracker",
  "version": "1.0.0",
  "description": "Track daily tasks by project and time, with status-based icon, CSV/JSON export-import, and Google Sheets sync.",
  "icons": {
    "16": "icons/freeze-16.png",
    "32": "icons/freeze-32.png",
    "48": "icons/freeze-48.png",
    "128": "icons/freeze-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/freeze-16.png",
      "32": "icons/freeze-32.png",
      "48": "icons/freeze-48.png",
      "128": "icons/freeze-128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "downloads", "notifications"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
  "options_page": "dashboard/dashboard.html"
}
